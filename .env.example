# Copia este archivo a .env, o generalo con: python scripts/bootstrap_env.py
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Minimo 32 caracteres. Generar con: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=30

# Archivo con los usuarios y sus hashes bcrypt. El repositorio trae credenciales de
# demostracion; para generar otras: python scripts/bootstrap_env.py --force
USERS_FILE=config/users.json

# Indexa el corpus al arrancar si el indice esta vacio. En false hay que llamar a
# POST /admin/ingest a mano antes de poder consultar.
AUTO_INGEST=true

REQUESTS_PER_MINUTE=10
LOGIN_ATTEMPTS_PER_MINUTE=5

# Techo por IP para todo el trafico, autenticado o no. Los otros limites son
# dependencias de ruta y solo cuentan peticiones que ya presentaron un token.
# El margen es amplio porque una carga de la interfaz son varias peticiones.
IP_REQUESTS_PER_MINUTE=60

# Largo permitido de la pregunta. Los aplica el guard de entrada, no el contrato:
# el contrato tiene un techo duro de 4000 que MAX_QUESTION_CHARS no puede superar.
MIN_QUESTION_CHARS=8
MAX_QUESTION_CHARS=600
DAILY_TOKEN_BUDGET=50000

# Espera minima entre dos reindexados completos. El lock impide que se solapen,
# pero encadenarlos satura el modelo y /ask empieza a devolver 503.
MIN_SECONDS_BETWEEN_INGESTS=60

LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text

# Bajo carga sostenida el modelo tarda mas que en una consulta aislada.
# Con 90 s las baterias de evals perdian intentos con 503 a mitad de corrida.
LLM_TIMEOUT_SECONDS=150
